# ====================================================================
# MEDISYNC CONFIGURATION & ENVIRONMENT VARIABLES
# Copy this file to .env and configure for your target deployment
# ====================================================================

# --------------------------------------------------------------------
# 1. Supabase PostgreSQL & Authentication Configuration
# --------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9... # NEVER expose on frontend

# --------------------------------------------------------------------
# 2. ABDM (Ayushman Bharat Digital Mission) Gateway Configuration
# --------------------------------------------------------------------
ABDM_ENVIRONMENT=SANDBOX # Options: SANDBOX or PRODUCTION
ABDM_BASE_URL=https://dev.abdm.gov.in/gateway
ABDM_CLIENT_ID=SBX_YOUR_NHA_CLIENT_ID
ABDM_CLIENT_SECRET=YOUR_NHA_SECRET_KEY
ABDM_HIP_ID=MEDISYNC_HOSPITAL_HIP_01
ABDM_HIU_ID=MEDISYNC_HOSPITAL_HIU_01
ABDM_CALLBACK_URL=http://localhost:8000/api/v0.5/callbacks
ABDM_REQUEST_TIMEOUT_SECONDS=20
ABDM_MOCK_FALLBACK_ENABLED=true # Enables resilient sandbox demonstration when NHA dev gateway is unreachable

# --------------------------------------------------------------------
# 3. Backend & Microservice Endpoints
# --------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --------------------------------------------------------------------
# 4. AI Clinical Assistant Configuration
# --------------------------------------------------------------------
AI_MODEL_NAME=MediSync-Clinical-RAG-v1.2
OPENAI_API_KEY= # Optional: Provide if routing through external LangChain OpenAI embeddings
